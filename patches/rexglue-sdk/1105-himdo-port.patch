+void VulkanCommandProcessor::AsyncSubmitThreadMain() {
+  rex::thread::set_current_thread_name("GPU Submit");
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  while (true) {
+    AsyncSubmitJob job;
+    {
+      std::unique_lock<std::mutex> lock(async_submit_mutex_);
+      async_submit_work_cv_.wait(lock,
+                                 [this]() { return async_submit_stop_ || !async_submit_queue_.empty(); });
+      if (async_submit_queue_.empty()) {
+        return;  // Stop requested and nothing left.
+      }
+      job = std::move(async_submit_queue_.front());
+      async_submit_queue_.pop_front();
+    }
+
+    // Same sequence as the synchronous path in EndSubmission.
+    bool ok = !async_submit_failed_;
+    bool device_lost = false;
+    if (ok && dfn.vkResetCommandPool(device, job.pool, 0) != VK_SUCCESS) {
+      REXGPU_ERROR("Failed to reset a Vulkan command pool (async submit)");
+      ok = false;
+    }
+    if (ok) {
+      VkCommandBufferBeginInfo begin_info;
+      begin_info.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+      begin_info.pNext = nullptr;
+      begin_info.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+      begin_info.pInheritanceInfo = nullptr;
+      if (dfn.vkBeginCommandBuffer(job.buffer, &begin_info) != VK_SUCCESS) {
+        REXGPU_ERROR("Failed to begin a Vulkan command buffer (async submit)");
+        ok = false;
+      }
+    }
+    if (ok) {
+      job.upload->Execute(job.buffer);
+      job.deferred->Execute(job.buffer);
+      if (dfn.vkEndCommandBuffer(job.buffer) != VK_SUCCESS) {
+        REXGPU_ERROR("Failed to end a Vulkan command buffer (async submit)");
+        ok = false;
+      }
+    }
+    if (ok) {
+      VkSubmitInfo submit_info;
+      submit_info.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+      submit_info.pNext = nullptr;
+      submit_info.waitSemaphoreCount = uint32_t(job.wait_semaphores.size());
+      submit_info.pWaitSemaphores = job.wait_semaphores.empty() ? nullptr : job.wait_semaphores.data();
+      submit_info.pWaitDstStageMask =
+          job.wait_stage_masks.empty() ? nullptr : job.wait_stage_masks.data();
+      submit_info.commandBufferCount = 1;
+      submit_info.pCommandBuffers = &job.buffer;
+      submit_info.signalSemaphoreCount = 0;
+      submit_info.pSignalSemaphores = nullptr;
+      VkResult submit_result;
+      {
+        ui::vulkan::VulkanDevice::Queue::Acquisition queue_acquisition =
+            vulkan_device->AcquireQueue(vulkan_device->queue_family_graphics_compute(), 0);
+        submit_result = dfn.vkQueueSubmit(queue_acquisition.queue(), 1, &submit_info, job.fence);
+      }
+      if (submit_result != VK_SUCCESS) {
+        REXGPU_ERROR("Failed to submit a Vulkan command buffer (async submit)");
+        ok = false;
+        device_lost = submit_result == VK_ERROR_DEVICE_LOST;
+      }
+    }
+
+    job.upload->Reset();
+    job.deferred->Reset();
+    {
+      std::unique_lock<std::mutex> lock(async_submit_mutex_);
+      async_submit_spare_buffers_.push_back(std::move(job.upload));
+      async_submit_spare_buffers_.push_back(std::move(job.deferred));
+      if (!ok) {
+        // The fence will never signal; waiters must not block on it.
+        async_submit_failed_ = true;
+        async_submit_device_lost_ = async_submit_device_lost_ || device_lost;
+      }
+      async_submitted_up_to_ = job.submission;
+    }
+    async_submit_done_cv_.notify_all();
+  }
+}
+
+bool VulkanCommandProcessor::WaitForAsyncSubmitted(uint64_t submission) {
+  std::unique_lock<std::mutex> lock(async_submit_mutex_);
+  // Never wait for a submission that hasn't been handed over (e.g. the open
+  // one); the caller clamps to submitted ones.
+  uint64_t last_handed_over = submission_completed_ + submissions_in_flight_fences_.size();
+  if (submission > last_handed_over) {
+    submission = last_handed_over;
+  }
+  async_submit_done_cv_.wait(lock, [&]() {
+    return async_submit_failed_ || async_submitted_up_to_ >= submission;
+  });
+  return !async_submit_failed_;
+}
+
+void VulkanCommandProcessor::ShutdownAsyncSubmit() {
+  {
+    std::unique_lock<std::mutex> lock(async_submit_mutex_);
+    async_submit_stop_ = true;
+  }
+  async_submit_work_cv_.notify_all();
+  if (async_submit_thread_.joinable()) {
+    async_submit_thread_.join();
+  }
+  async_submit_spare_buffers_.clear();
+}
