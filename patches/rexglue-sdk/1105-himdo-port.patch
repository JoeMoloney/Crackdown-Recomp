+        static_cast<D3D12Texture*>(found[i])->resource_state() !=
+            D3D12_RESOURCE_STATE_COPY_DEST) {
+      resolve_copy_textures_[resolve_copy_texture_count_++] = found[i];
+    }
+  }
+  return resolve_copy_texture_count_;
