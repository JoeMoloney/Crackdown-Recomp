+  if (l && r)
+    l = r = false;
+  uint64_t f = 0;
+  if (u && l) {
+    u = l = false;
+    f |= uint64_t(1) << (22 + shift);
+  }
+  if (u && r) {
+    u = r = false;
+    f |= uint64_t(1) << (23 + shift);
+  }
+  if (d && r) {
+    d = r = false;
+    f |= uint64_t(1) << (24 + shift);
+  }
+  if (d && l) {
+    d = l = false;
+    f |= uint64_t(1) << (25 + shift);
+  }
+  f |= uint64_t(u) << (18 + shift);
+  f |= uint64_t(d) << (19 + shift);
+  f |= uint64_t(r) << (20 + shift);
+  f |= uint64_t(l) << (21 + shift);
