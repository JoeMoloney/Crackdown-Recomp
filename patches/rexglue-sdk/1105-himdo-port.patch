diff --git a/include/rex/system/guest_fault_region.h b/include/rex/system/guest_fault_region.h
new file mode 100644
index 0000000..4d4c29c
--- /dev/null
+++ b/include/rex/system/guest_fault_region.h
@@ -0,0 +1,66 @@
+#pragma once
+
+#include <cstdint>
+
+namespace rex::memory {
+
+// Bounds of the faulting thread's stack, as published in its PCR.
+struct GuestStackBounds {
+  uint32_t limit = 0;
+  uint32_t base = 0;
+
+  constexpr bool known() const { return base > limit; }
+};
+
+enum class GuestFaultRegion {
+  kFree,
+  kReserved,
+  kCommitted,
+  kNoAccess,
+  kOwnStack,
+  kOwnStackGuard,
+  kOwnStackAbove,
+};
+
+// Stacks are allocated with one no-access guard page below the limit and one above the base.
+constexpr GuestFaultRegion ClassifyGuestFaultRegion(uint32_t page, uint32_t page_size,
+                                                    bool reserved, bool committed,
+                                                    bool no_access, GuestStackBounds stack) {
+  if (stack.known()) {
+    if (page >= stack.limit && page < stack.base) {
+      return GuestFaultRegion::kOwnStack;
+    }
+    if (page == stack.base || page + page_size == stack.limit) {
+      return GuestFaultRegion::kOwnStackGuard;
+    }
+    if (page == stack.base + page_size) {
+      return GuestFaultRegion::kOwnStackAbove;
+    }
+  }
+  if (committed) {
+    return no_access ? GuestFaultRegion::kNoAccess : GuestFaultRegion::kCommitted;
+  }
+  return reserved ? GuestFaultRegion::kReserved : GuestFaultRegion::kFree;
+}
+
+constexpr const char* GuestFaultRegionName(GuestFaultRegion region) {
+  switch (region) {
+    case GuestFaultRegion::kFree:
+      return "free";
+    case GuestFaultRegion::kReserved:
+      return "reserved";
+    case GuestFaultRegion::kCommitted:
+      return "committed";
+    case GuestFaultRegion::kNoAccess:
+      return "no_access";
+    case GuestFaultRegion::kOwnStack:
+      return "own_stack";
+    case GuestFaultRegion::kOwnStackGuard:
+      return "own_stack_guard";
+    case GuestFaultRegion::kOwnStackAbove:
+      return "own_stack_above";
+  }
+  return "unknown";
+}
+
+}  // namespace rex::memory
diff --git a/include/rex/system/guest_page_recovery.h b/include/rex/system/guest_page_recovery.h
new file mode 100644
index 0000000..499fb1b
--- /dev/null
+++ b/include/rex/system/guest_page_recovery.h
@@ -0,0 +1,62 @@
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+#include <rex/system/guest_fault_region.h>
+
+namespace rex::memory {
+
+enum class GuestAccessKind { kRead, kWrite, kExecute };
+
+enum class GuestPageRecoveryVerdict {
+  kRecover,
+  kNotEligible,
+  kAlreadyRecovered,
+  kSequential,
+  kLimitReached,
+};
+
+class GuestPageRecovery {
+ public:
+  static constexpr uint32_t kRangeBegin = 0x70000000;
+  static constexpr uint32_t kRangeEnd = 0x70FFFFFF;
+  static constexpr uint32_t kMaxPages = 8;
+
+  // Only unmapped pages away from the faulting thread's stack qualify; a stack overrun must crash.
+  GuestPageRecoveryVerdict Evaluate(GuestAccessKind access, uint32_t guest_address,
+                                    uint32_t page_address, uint32_t page_size,
+                                    GuestFaultRegion region, bool stack_known) const {
+    if (access != GuestAccessKind::kRead || guest_address < kRangeBegin ||
+        guest_address > kRangeEnd || !stack_known ||
+        (region != GuestFaultRegion::kFree && region != GuestFaultRegion::kReserved)) {
+      return GuestPageRecoveryVerdict::kNotEligible;
+    }
+    for (uint32_t i = 0; i < count_; ++i) {
+      if (pages_[i] == page_address) {
+        return GuestPageRecoveryVerdict::kAlreadyRecovered;
+      }
+    }
+    for (uint32_t i = 0; i < count_; ++i) {
+      if (pages_[i] + page_size == page_address || page_address + page_size == pages_[i]) {
+        return GuestPageRecoveryVerdict::kSequential;
+      }
+    }
+    return count_ >= kMaxPages ? GuestPageRecoveryVerdict::kLimitReached
+                               : GuestPageRecoveryVerdict::kRecover;
+  }
+
+  void Record(uint32_t page_address) {
+    if (count_ < kMaxPages) {
+      pages_[count_++] = page_address;
+    }
+  }
+
+  uint32_t count() const { return count_; }
+
+ private:
+  std::array<uint32_t, kMaxPages> pages_{};
+  uint32_t count_ = 0;
+};
+
+}  // namespace rex::memory
