+//=============================================================================
+// Vector Reciprocal Square Root Estimate (vrsqrtefp / vrsqrtefp128)
+//=============================================================================
+// Bit-exact model of the VMX estimate, ported from Xenia Canary
+// (src/xenia/cpu/backend/x64/x64_backend.cc, ComputeNormalVRsqrteTableValue and
+// EmitScalarVRsqrteHelper, BSD license).
+
+namespace rex::ppc {
+namespace detail {
+inline constexpr uint32_t kVRsqrteCoefficients[32] = {
+    0x568B4FD, 0x4F3AF97, 0x48DAAA5, 0x435A618, 0x3E7A1E4, 0x3A29DFE, 0x3659A5C, 0x32E96F8,
+    0x2FC93CA, 0x2D090CE, 0x2A88DFE, 0x2838B57, 0x26188D4, 0x2438673, 0x2268431, 0x20B820B,
+    0x3D27FFA, 0x3807C29, 0x33878AA, 0x2F97572, 0x2C27279, 0x2926FB7, 0x2666D26, 0x23F6AC0,
+    0x21D6881, 0x1FD6665, 0x1E16468, 0x1C76287, 0x1AF60C1, 0x1995F12, 0x1855D79, 0x1735BF4,
+};
+
+// The estimate ignores the low 9 mantissa bits, so the next 14 mantissa bits and the
+// exponent's low bit select one of 32768 results.
+inline uint32_t VRsqrteTableValue(uint32_t input) {
+  const uint32_t mantissa = input & 0x7FFFFF;
+  const uint32_t coefficient =
+      kVRsqrteCoefficients[(((input >> 23) & 1) << 4) | (mantissa >> 19)];
+  uint32_t estimate =
+      ((coefficient << 10) & 0x3FFFC00) - (((mantissa >> 9) & 1023) * (coefficient >> 16));
+  int32_t exponent_adjust = 0;
+  if (!(estimate & 0x02000000)) {
+    const uint32_t normalized = estimate & 0x1FFFFFF;
+    uint32_t leading_zeros = 0;
+    for (uint32_t bit = 0x80000000; !(normalized & bit); bit >>= 1) {
+      ++leading_zeros;
+    }
+    exponent_adjust += 6 - int32_t(leading_zeros);
+    estimate <<= leading_zeros - 6;
+  }
+  if ((estimate & 5) && (estimate & 2)) {
+    estimate += 4;
+  }
+  return (0x3F800000 + uint32_t(exponent_adjust) * 0x00800000) | ((estimate >> 2) & 0x7FFFFF);
+}
+
+inline const uint32_t* VRsqrteTable() {
+  static const struct Table {
+    alignas(64) uint32_t v[1 << 15];
+    Table() {
+      for (uint32_t i = 0; i < (1u << 15); ++i) {
+        v[i] = VRsqrteTableValue(((126 + (i >> 14)) << 23) | ((i & 0x3FFF) << 9));
+      }
+    }
+  } table;
+  return table.v;
+}
+}  // namespace detail
+
+// One lane. Denormal inputs are treated as zero, as with VSCR[NJ] set.
+inline uint32_t vrsqrtefp_bits(uint32_t b, const uint32_t* table) {
+  if (b - 0x00800000u <= 0x7EFFFFFFu) {  // positive normal
+    return table[(b >> 9) & 0x7FFF] - (((b >> 24) - 63) << 23);
+  }
+  const uint32_t exponent = (b >> 23) & 0xFF;
+  if (exponent == 0) {
+    return (b >> 31) ? 0xFF800000 : 0x7F800000;  // +-0 or denormal -> +-inf
+  }
+  if (exponent == 0xFF && (b & 0x7FFFFF)) {
+    return b | 0x00400000;  // NaN, quieted
+  }
+  if (b == 0x7F800000) {
+    return 0;  // +inf -> +0
+  }
+  return 0x7FC00000;  // negative -> default NaN
+}
+
+inline simde__m128 simde_mm_vrsqrtefp(simde__m128 src) {
+  const uint32_t* table = detail::VRsqrteTable();
+  alignas(16) uint32_t lanes[4];
+  simde_mm_store_ps(reinterpret_cast<float*>(lanes), src);
+  for (uint32_t& lane : lanes) {
+    lane = vrsqrtefp_bits(lane, table);
+  }
+  return simde_mm_load_ps(reinterpret_cast<const float*>(lanes));
+}
+}  // namespace rex::ppc
+
+//=============================================================================
+// Vector Multiply-Add (vmaddfp, vmaddfp128, vmaddcfp128, vnmsubfp, vnmsubfp128)
+//=============================================================================
+// The VMX unit rounds a multiply-add once, like Xenia's MUL_ADD_V128 (vfmadd213ps); a separate
+// multiply and add rounds twice. Titles that normalize with vrsqrtefp and a Newton-Raphson step
+// rely on the single rounding to keep a unit length within an ulp of 1.0. Without FMA3 the result is
+// still fused: a float product is exact in double, TwoSum gives the exact error of the double sum,
+// and rounding that sum to odd before rounding it to float gives the correctly rounded result
+// (Boldo and Melquiond, "Emulation of FMA and correctly rounded sums: proved algorithms using
+// rounding to odd", 2008). An x64 build without -mfma checks the CPU once and uses vfmadd213ps
+// when it has FMA3, so both paths give the same bits and no CPU is required to have FMA3. Runs
+// under the VMX flush mode, so denormal inputs read as zero and a denormal result flushes to zero.
+
+#if defined(__FMA__) || defined(__aarch64__) || defined(_M_ARM64)
+#define REX_PPC_NATIVE_FMA 1
+#include <simde/x86/fma.h>
+#elif (defined(__x86_64__) || defined(_M_X64)) && (defined(__clang__) || defined(__GNUC__))
+#define REX_PPC_DISPATCH_FMA 1
+#endif
+#include <cstdint>
+#include <limits>
+
+namespace rex::ppc {
+namespace detail {
+// a * b + c for two lanes holding floats, rounded to odd at double precision.
+inline simde__m128d FusedToOdd(simde__m128d a, simde__m128d b, simde__m128d c) {
+  const simde__m128d product = simde_mm_mul_pd(a, b);
+  const simde__m128d sum = simde_mm_add_pd(product, c);
+  const simde__m128d c_part = simde_mm_sub_pd(sum, product);
+  const simde__m128d error = simde_mm_add_pd(
+      simde_mm_sub_pd(product, simde_mm_sub_pd(sum, c_part)), simde_mm_sub_pd(c, c_part));
+  // An inexact sum with an even last bit moves one ulp towards its error. A NaN or infinite sum
+  // has a NaN error and is left as it is.
+  const simde__m128i inexact = simde_mm_castpd_si128(simde_mm_andnot_pd(
+      simde_mm_cmpeq_pd(error, simde_mm_setzero_pd()), simde_mm_cmpord_pd(error, error)));
+  const simde__m128i bits = simde_mm_castpd_si128(sum);
+  const simde__m128i one = simde_mm_set1_epi64x(1);
+  const simde__m128i even =
+      simde_mm_cmpeq_epi64(simde_mm_and_si128(bits, one), simde_mm_setzero_si128());
+  // +1 moves away from zero when the error has the sum's sign, -1 moves towards zero otherwise.
+  const simde__m128i opposite =
+      simde_mm_srli_epi64(simde_mm_xor_si128(bits, simde_mm_castpd_si128(error)), 63);
+  const simde__m128i step = simde_mm_sub_epi64(one, simde_mm_slli_epi64(opposite, 1));
+  return simde_mm_castsi128_pd(
+      simde_mm_add_epi64(bits, simde_mm_and_si128(step, simde_mm_and_si128(inexact, even))));
+}
+
+inline simde__m128 EmulatedVmaddfp(simde__m128 a, simde__m128 b, simde__m128 c) {
+  const simde__m128d low =
+      FusedToOdd(simde_mm_cvtps_pd(a), simde_mm_cvtps_pd(b), simde_mm_cvtps_pd(c));
+  const simde__m128d high = FusedToOdd(simde_mm_cvtps_pd(simde_mm_movehl_ps(a, a)),
+                                       simde_mm_cvtps_pd(simde_mm_movehl_ps(b, b)),
+                                       simde_mm_cvtps_pd(simde_mm_movehl_ps(c, c)));
+  return simde_mm_movelh_ps(simde_mm_cvtpd_ps(low), simde_mm_cvtpd_ps(high));
+}
+
+#if defined(REX_PPC_DISPATCH_FMA)
+// FMA3, and the OS saving the AVX state that VEX encodings need.
+inline bool HostHasFma() {
+  uint32_t regs[4];
+  __asm__("cpuid" : "=a"(regs[0]), "=b"(regs[1]), "=c"(regs[2]), "=d"(regs[3]) : "a"(1u), "c"(0u));
+  constexpr uint32_t kFmaOsxsaveAvx = (1u << 12) | (1u << 27) | (1u << 28);
+  if ((regs[2] & kFmaOsxsaveAvx) != kFmaOsxsaveAvx) {
+    return false;
+  }
+  uint32_t xcr0[2];
+  __asm__("xgetbv" : "=a"(xcr0[0]), "=d"(xcr0[1]) : "c"(0u));
+  return (xcr0[0] & 6u) == 6u;
+}
+
+inline const bool kHostHasFma = HostHasFma();
+#endif
+}  // namespace detail
+
+inline simde__m128 simde_mm_vmaddfp(simde__m128 a, simde__m128 b, simde__m128 c) {
+#if defined(REX_PPC_NATIVE_FMA)
+  return simde_mm_fmadd_ps(a, b, c);
+#else
+#if defined(REX_PPC_DISPATCH_FMA)
+  if (detail::kHostHasFma) {
+    // a = a * b + c: NaN operands win in a, b, c order, as in the emulation.
+    __asm__("vfmadd213ps %2, %1, %0" : "+x"(a) : "x"(b), "x"(c));
+    return a;
+  }
+#endif
+  return detail::EmulatedVmaddfp(a, b, c);
+#endif
+}
+
+// -(a * b - c), negated by flipping the sign bit.
+inline simde__m128 simde_mm_vnmsubfp(simde__m128 a, simde__m128 b, simde__m128 c) {
+  const simde__m128 sign = simde_mm_castsi128_ps(simde_mm_set1_epi32(int(0x80000000)));
+  return simde_mm_xor_ps(simde_mm_vmaddfp(a, b, simde_mm_xor_ps(c, sign)), sign);
+}
+
+//=============================================================================
+// Vector Dot Products (vmsum3fp128 / vmsum4fp128)
+//=============================================================================
+// Products and sums in double, rounded to float once, in the order of Xenia's DOT_PRODUCT_3/4
+// (src/xenia/cpu/backend/x64/x64_sequences.cc, BSD license), as in Unowa001/crackdown-recomp
+// (BSD 3-Clause). dpps rounds after every multiply and add, so a squared length or the dot product
+// of unit vectors can land an ulp away from the hardware result. Host lane 3 - i holds guest
+// element i.
+
+namespace detail {
+inline simde__m128 VmsumResult(simde__m128d sum) {
+  const double total = simde_mm_cvtsd_f64(sum);
+  float result = float(total);
+  // Four float products cannot overflow double, so an infinite float from a finite sum is a float
+  // overflow, which gives the default NaN (as in Xenia).
+  if (std::isinf(result) && std::isfinite(total)) {
+    result = std::numeric_limits<float>::quiet_NaN();
+  }
+  return simde_mm_set1_ps(result);
+}
+
+// {w * w', z * z'} and {y * y', x * x'}.
+inline void VmsumProducts(simde__m128 a, simde__m128 b, simde__m128d& wz, simde__m128d& yx) {
+  wz = simde_mm_mul_pd(simde_mm_cvtps_pd(a), simde_mm_cvtps_pd(b));
+  yx = simde_mm_mul_pd(simde_mm_cvtps_pd(simde_mm_movehl_ps(a, a)),
+                       simde_mm_cvtps_pd(simde_mm_movehl_ps(b, b)));
+}
+}  // namespace detail
+
+// (x + z) + y
+inline simde__m128 simde_mm_vmsum3fp(simde__m128 a, simde__m128 b) {
+  simde__m128d wz, yx;
+  detail::VmsumProducts(a, b, wz, yx);
+  const simde__m128d pairs = simde_mm_add_pd(yx, wz);
+  return detail::VmsumResult(simde_mm_add_sd(simde_mm_unpackhi_pd(pairs, pairs), yx));
+}
+
+// (x + z) + (y + w)
+inline simde__m128 simde_mm_vmsum4fp(simde__m128 a, simde__m128 b) {
+  simde__m128d wz, yx;
+  detail::VmsumProducts(a, b, wz, yx);
+  const simde__m128d pairs = simde_mm_add_pd(yx, wz);
+  return detail::VmsumResult(simde_mm_add_sd(simde_mm_unpackhi_pd(pairs, pairs), pairs));
+}
+}  // namespace rex::ppc
